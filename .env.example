# Spotify Developer API Credentials
# Get your free Client ID and Client Secret at: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=https://127.0.0.1:8888/callback

# Apple Music Credentials (Direct Cloud API Sync)
# Log in to https://music.apple.com in browser -> DevTools (F12) -> Cookies -> Copy media-user-token
APPLE_MUSIC_USER_TOKEN=your_apple_music_media_user_token_here
