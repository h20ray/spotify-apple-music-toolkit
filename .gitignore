.env
.cache/
.cache
.cache-*
.spotipy-cache*
__pycache__/
*.pyc
scratch/
.vscode/
.idea/

# Ignore playlist search cache files
playlist_exports/**/search_cache.json
playlist_exports/**/apple_music_search_cache.json

# Exclude all copyrighted audio files and lyrics in audio_library to comply with DMCA
audio_library/*
!audio_library/.gitkeep
playlist_sources/lyrics/*
!playlist_sources/lyrics/.gitkeep
/temp

# Generated by the album fixer (local paths, personal library data)
reports/album_fix_report.tsv
reports/album_fix_backup_*.json
